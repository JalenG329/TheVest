# haptic_vr_mariokart_receiver.py
# ---------------------------------------------------------
# VR Haptic Jacket Receiver for Rehab / Mario-Kart-Style Game
# - Receives UDP packets from Unity / Oculus Quest app
# - Pulses motors continuously while user is imbalanced or off-path
# - Stops all motors when user is centered and stable
#
# Zones:
#   0 = FAR LEFT
#   1 = SLIGHT LEFT
#   2 = SLIGHT RIGHT
#   3 = FAR RIGHT
#   4 = BOTTOM / FORWARD WARNING
# ---------------------------------------------------------

import time
import json
import math
import socket
import threading
import board
import busio
import adafruit_tca9548a
from adafruit_drv2605 import DRV2605, MODE_REALTIME

# ===================== CONFIG =====================
NUM_ZONES = 5
UPDATE_INTERVAL = 0.04
MIN_UPDATE_STEP = 2

UDP_IP = "0.0.0.0"
UDP_PORT = 5005
PACKET_TIMEOUT = 0.8

# Pulse settings
PULSE_PERIOD = 0.8          # seconds per full pulse cycle
PULSE_MIN_SCALE = 0.35      # minimum pulse percentage of target intensity
PULSE_MAX_SCALE = 1.0       # maximum pulse percentage

DRV_CHANNEL_MAP = [3, 5, 7, 0, 1]

MOTOR_LABELS = {
    0: "FAR LEFT (ch 3)",
    1: "SLIGHT LEFT (ch 5)",
    2: "SLIGHT RIGHT (ch 7)",
    3: "FAR RIGHT (ch 0)",
    4: "BOTTOM / FORWARD (ch 1)"
}

# ===================== I2C + DRV =====================
i2c = busio.I2C(board.SCL, board.SDA)
mux = adafruit_tca9548a.TCA9548A(i2c)

drvs = []
for ch in DRV_CHANNEL_MAP:
    try:
        time.sleep(0.12)
        d = DRV2605(mux[ch])
        d.mode = MODE_REALTIME
        d.realtime_value = 0
        drvs.append(d)
        print(f"[INIT] DRV ready on mux channel {ch}")
    except Exception as e:
        drvs.append(None)
        print(f"[WARN] Failed to init DRV on mux channel {ch}: {e}")

# ===================== STATE =====================
vr_state = {
    "zones": [0] * NUM_ZONES,      # target intensities sent by Unity
    "event": "stable",
    "last_packet_time": 0.0
}

state_lock = threading.Lock()
last_written = [0] * NUM_ZONES
last_update = 0.0

# ===================== HELPERS =====================


def clamp_intensity(v):
    try:
        return max(0, min(127, int(v)))
    except Exception:
        return 0


def shutdown_motors():
    print("[SAFE EXIT] Turning off all motors...")
    for i, drv in enumerate(drvs):
        try:
            if drv is not None:
                drv.realtime_value = 0
        except Exception as e:
            print(f"[WARN] Failed to stop motor {i}: {e}")


def get_safe_state():
    with state_lock:
        age = time.time() - vr_state["last_packet_time"]
        if age > PACKET_TIMEOUT:
            return [0] * NUM_ZONES, "stale"
        return vr_state["zones"][:], vr_state["event"]


def pulse_value(target_intensity, now):
    """
    Smooth repeating pulse while error is present.
    Output stays between PULSE_MIN_SCALE and PULSE_MAX_SCALE of target.
    """
    if target_intensity <= 0:
        return 0

    phase = (now % PULSE_PERIOD) / PULSE_PERIOD
    wave = 0.5 * (1.0 + math.sin(2.0 * math.pi *
                  phase - math.pi / 2.0))  # 0..1
    scale = PULSE_MIN_SCALE + (PULSE_MAX_SCALE - PULSE_MIN_SCALE) * wave
    return clamp_intensity(round(target_intensity * scale))

# ===================== UDP LISTENER =====================


def udp_listener():
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.bind((UDP_IP, UDP_PORT))
    sock.settimeout(0.25)

    print(f"[VR] Listening for UDP packets on {UDP_IP}:{UDP_PORT}")

    while True:
        try:
            data, addr = sock.recvfrom(2048)
            msg = json.loads(data.decode("utf-8"))

            zones = msg.get("zones", [0] * NUM_ZONES)
            event = msg.get("event", "stable")

            if not isinstance(zones, list) or len(zones) != NUM_ZONES:
                print(f"[VR WARN] Invalid zones from {addr}: {zones}")
                continue

            zones = [clamp_intensity(v) for v in zones]

            with state_lock:
                vr_state["zones"] = zones
                vr_state["event"] = str(event)
                vr_state["last_packet_time"] = time.time()

            print(f"[VR RX] {addr} | Event: {event} | Target Zones: {zones}")

        except socket.timeout:
            pass
        except Exception as e:
            print(f"[VR ERROR] {e}")


# ===================== MAIN LOOP =====================
print("VR Haptic Receiver running. Press Ctrl+C to exit.")

listener_thread = threading.Thread(target=udp_listener, daemon=True)
listener_thread.start()

try:
    while True:
        now = time.time()

        if now - last_update >= UPDATE_INTERVAL:
            target_zones, event = get_safe_state()

            # Apply pulsing to any active target zone
            desired = [pulse_value(v, now) for v in target_zones]

            for i, val in enumerate(desired):
                drv = drvs[i]
                if drv is None:
                    continue

                prev = last_written[i]
                should_write = abs(
                    val - prev) >= MIN_UPDATE_STEP or (val == 0 and prev != 0)

                if should_write:
                    try:
                        drv.realtime_value = val
                        last_written[i] = val

                        if val > 0:
                            print(
                                f"[HAPTIC] {MOTOR_LABELS[i]} | Event: {event} | Pulsing: {val}")
                        else:
                            print(f"[HAPTIC] {MOTOR_LABELS[i]} | OFF")
                    except Exception as e:
                        print(f"[WARN] Failed to write motor {i}: {e}")

            last_update = now

        time.sleep(0.005)

except KeyboardInterrupt:
    print("\n[CTRL+C] Interrupted")

finally:
    shutdown_motors()
    print("[EXIT] Shutdown complete")
